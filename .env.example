# Optional LLM Configuration
# Inkloom Shield has a full built-in deterministic audit engine that runs with zero-auth.
# Configure an API key below to enable optional live provider audits.

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

